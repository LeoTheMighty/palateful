#!/bin/bash
# Show production service status at a glance.
#
# Usage: bin/prod-status

set -euo pipefail

CLUSTER="palateful-prod"

echo "=== Palateful Production Status ==="
echo ""

# ECS Services — one describe-services call feeds both the status table and
# the deployed-tag age check below.
SERVICES_JSON=$(aws ecs describe-services --cluster "$CLUSTER" \
  --services palateful-api-prod palateful-worker-prod \
  --output json 2>/dev/null)

echo "ECS Services:"
echo "$SERVICES_JSON" | jq -r \
  '.services[] | "  \(.serviceName): \(.runningCount)/\(.desiredCount) running (\(.status))"'

# Deployed tag + age. services[].taskDefinition is the revision ARN actually
# in service — NOT the family shortcut, which reports the newest REGISTERED
# revision even if it was never deployed (see deploy-freshness.yml).
echo ""
echo "Deployed images:"
for SVC in palateful-api-prod palateful-worker-prod; do
  TD=$(echo "$SERVICES_JSON" | jq -r \
    ".services[] | select(.serviceName==\"$SVC\") | .taskDefinition")
  IMAGE=$(aws ecs describe-task-definition --task-definition "$TD" \
    --query 'taskDefinition.containerDefinitions[0].image' --output text 2>/dev/null)
  TAG="${IMAGE##*:}"
  if git cat-file -e "${TAG}^{commit}" 2>/dev/null; then
    AGE_DAYS=$(( ($(date +%s) - $(git log -1 --format=%ct "$TAG")) / 86400 ))
    echo "  $SVC: $TAG — ${AGE_DAYS}d old ($(git log -1 --format='%cr, %s' "$TAG"))"
  else
    echo "  $SVC: $TAG — age unknown (tag is not a commit in this checkout; try 'git fetch')"
  fi
done

# Health check
echo ""
echo "API Health:"
if curl -sf "https://api.palateful.app/v1/health" 2>/dev/null; then
  echo ""
else
  echo "  UNHEALTHY or unreachable"
fi

# RDS
echo ""
echo "RDS:"
aws rds describe-db-instances \
  --db-instance-identifier palateful-db-prod \
  --query 'DBInstances[0].{Status:DBInstanceStatus,Class:DBInstanceClass,Engine:Engine,Endpoint:Endpoint.Address}' \
  --output table 2>/dev/null

# Recent errors
echo ""
echo "Batch Parser (recent jobs):"
for s in RUNNING RUNNABLE FAILED SUCCEEDED; do
  COUNT=$(aws batch list-jobs --job-queue palateful-parser-queue-prod --job-status "$s" \
    --query 'length(jobSummaryList)' --output text 2>/dev/null)
  if [ "$COUNT" != "0" ]; then
    echo "  $s: $COUNT"
  fi
done
