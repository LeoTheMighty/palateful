# Database (async PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palateful

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth0 Configuration
AUTH0_DOMAIN=auth.palateful.app
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.palateful.app

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Application
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Ngrok (for mobile testing)
NGROK_AUTHTOKEN=your-ngrok-authtoken

# Push notifications (Firebase Cloud Messaging)
# Optional. When BOTH FIREBASE_CREDENTIALS_JSON and FIREBASE_CREDENTIALS_PATH
# are unset, PushNotificationService runs in log-only mode and pushes are
# NOT delivered to devices — the service logs each payload it would have
# sent and returns message_id="log-only". Local dev default.
#
# In production, FIREBASE_CREDENTIALS_JSON is provided via AWS Secrets
# Manager (see terraform/modules/ecs). Set FIREBASE_CREDENTIALS_PATH
# instead if you have the service-account JSON on disk (useful for
# staging where you mount the file). See docs/PUSH_NOTIFICATIONS.md
# for the APNs .p8 upload procedure and the local-dev/prod flow.
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=
