{
  "name": "eval",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/eval/src",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry install",
        "cwd": "{projectRoot}"
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry lock",
        "cwd": "{projectRoot}"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval run",
        "cwd": "{projectRoot}"
      }
    },
    "eval-llm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval eval-llm",
        "cwd": "{projectRoot}"
      }
    },
    "run-ocr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval run --suite ocr",
        "cwd": "{projectRoot}"
      }
    },
    "run-recipe": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval run --suite recipe_extraction",
        "cwd": "{projectRoot}"
      }
    },
    "run-matching": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval run --suite ingredient_matching",
        "cwd": "{projectRoot}"
      }
    },
    "run-recipe-parse": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval eval-llm --cases recipe_parse",
        "cwd": "{projectRoot}"
      }
    },
    "run-chat-agent": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval eval-llm --cases chat_agent",
        "cwd": "{projectRoot}"
      }
    },
    "report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main report --format html",
        "cwd": "{projectRoot}"
      }
    },
    "add-case": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main add-case",
        "cwd": "{projectRoot}"
      }
    },
    "run-fixtures": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval run-fixtures",
        "cwd": "{projectRoot}"
      }
    },
    "confidence-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.main --env-file .env.eval confidence-gate",
        "cwd": "{projectRoot}"
      }
    },
    "eval-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run python -m src.gate",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run ruff check {projectRoot}/src/ {projectRoot}/tests/",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry run pytest",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["service", "python", "eval"]
}
