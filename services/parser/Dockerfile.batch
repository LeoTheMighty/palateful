# Parser Service Dockerfile for AWS Batch
# Uses NVIDIA CUDA for GPU support

FROM --platform=linux/amd64 nvidia/cuda:12.4.1-runtime-ubuntu22.04

WORKDIR /app

# Prevent interactive prompts during install
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Python 3.12 from deadsnakes PPA
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3

# Install pip for Python 3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python

# Install Poetry
RUN pip install poetry

# Copy poetry files
COPY services/parser/pyproject.toml services/parser/poetry.lock* ./

# Install dependencies
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main

# Upgrade transformers to latest — required for native hunyuan_vl model type support
RUN pip install --upgrade transformers

# Copy application code
COPY services/parser/src ./src
COPY services/parser/run_job.py ./run_job.py

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/models

# Pre-download ALL model files (weights + custom modeling code) into the image.
# snapshot_download grabs everything including *.py files needed for trust_remote_code.
# Eliminates ~3-5 min HuggingFace download on every job.
RUN python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download('tencent/HunyuanOCR')"

# Run the batch job script
CMD ["python", "run_job.py"]
