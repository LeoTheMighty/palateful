# Parser Service Dockerfile for AWS Batch
# Uses NVIDIA CUDA for GPU support

FROM --platform=linux/amd64 nvidia/cuda:12.4.1-runtime-ubuntu22.04

WORKDIR /app

# Prevent interactive prompts during install
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Python 3.12 from deadsnakes PPA
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3

# Install pip for Python 3.12
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python

# Install Poetry
RUN pip install poetry

# Copy poetry files
COPY services/parser/pyproject.toml services/parser/poetry.lock* ./

# Install dependencies
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --no-root --only main

# Install git (needed to pip install from GitHub) then install specific
# transformers commit with hunyuan_vl support.
# Per https://github.com/Tencent-Hunyuan/HunyuanOCR — this commit has not been
# merged into a release yet, so we pin to the exact commit Tencent recommends.
# Install specific transformers commit with hunyuan_vl support + torchvision.
# Download as tarball to avoid needing git installed in the container.
# Install pinned transformers with hunyuan_vl support.
# --no-deps prevents reinstalling torch/nvidia which conflict with CUDA base image.
RUN pip install --no-deps https://github.com/huggingface/transformers/archive/82a06db03535c49aa987719ed0746a76093b1ec4.tar.gz

# Create torchvision shim with transforms that HunYuanVLImageProcessor needs.
# Full torchvision can't be installed due to C extension conflicts.
COPY services/parser/torchvision_shim /usr/local/lib/python3.12/dist-packages/torchvision

# Copy application code
COPY services/parser/src ./src
COPY services/parser/run_job.py ./run_job.py

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/models

# NOTE: Model weights are downloaded at runtime (~3-5 min on first run).
# Pre-baking was removed due to huggingface_hub compatibility issues with
# the pinned transformers commit. Can be re-added once transformers merges
# hunyuan_vl support into a stable release.

# Run the batch job script
CMD ["python", "run_job.py"]
