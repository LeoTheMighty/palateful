{
  "name": "test-helper",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libraries/test-helper/test_helper",
  "implicitDependencies": ["utils"],
  "targets": {
    "lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "poetry lock",
        "cwd": "{projectRoot}"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["poetry install"],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["poetry run ruff check {projectRoot}/test_helper/"],
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p coverage/libraries/test-helper && COVERAGE_FILE=coverage/libraries/test-helper/.coverage poetry run pytest libraries/test-helper/ --cov-report xml:coverage/libraries/test-helper/coverage.xml --cov-report html:coverage/libraries/test-helper/html --junitxml=reports/libraries/test-helper/unittests/junit.xml --html=reports/libraries/test-helper/unittests/html/index.html"
        ],
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": ["library", "python", "testing"]
}
